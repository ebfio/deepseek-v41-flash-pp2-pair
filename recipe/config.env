# Shared configuration for the two-node GB300 pair (rendered by roles/gb300_pair from group_vars).
# Sourced by serve_vllm_node.sh / launch_cluster.sh / stop_cluster.sh / status.sh / preflight.sh.
# Mechanism is catid's dgx_station_benchmarks recipe, vendored verbatim; only this config is ours.
# Override any value in the environment, e.g. MODE=throughput ./launch_cluster.sh

: "${ENGINE:=vllm}                              # sglang | vllm"
: "${IMAGE:=vllm/vllm-openai:v0.31.0}   # unused when ENGINE=vllm; scripts reference it"
: "${VLLM_IMAGE:=vllm/vllm-openai:v0.31.0}   # vLLM image (must be identical on both nodes)"
: "${CONTAINER_NAME:=gb300-pair-vllm}"
: "${SERVED_MODEL_NAME:=deepseek-v4.1-flash}"

# Rank 0 = the API host (erebus); rank 1 = hades (auto-cleanable side).
# Rail 0 carries the torch.distributed bootstrap + NCCL; rail 1 is also handed to NCCL for dual-rail collectives.
: "${RANK0_IP:=<rank0-rail0-ip>}                  # rank 0, rail 0 interface IP"
: "${RANK1_IP:=<rank1-rail0-ip>}                  # rank 1, rail 0 interface IP"
: "${RANK1_RAIL1_IP:=<rank1-rail1-ip>}            # rank 1, rail 1 (preflight jumbo-ping target)"
: "${RANK1_SSH:=<user>@<rank1-mgmt-ip>}           # ssh target for rank 1 (BatchMode key installed by the role)"
: "${SWAP_RANKS:=0}"
: "${MASTER_PORT:=20000}                          # --dist-init-addr port"
: "${API_PORT:=8001}"
: "${API_HOST:=0.0.0.0}                        # 0.0.0.0 so litellm reaches the API off-box"

: "${FABRIC_IFACE:=cx8r0}                 # rail 0 netdev (GLOO/NCCL bootstrap)"
: "${NCCL_HCAS:=mlx5_0,mlx5_1}                    # dual-rail RoCE; both ACTIVE on this fabric"
: "${NCCL_TUNING:=tuned}                          # tuned = RING/SIMPLE/8ch/4QP striping (measured best on this fabric)"
: "${NCCL_DEBUG_LEVEL:=WARN}"
: "${NCCL_DEBUG_SUBSYS:=INIT,NET}"
: "${HOST_RDMA:=1}                                # 1 -> bind-mount host MOFED libs for the ConnectX-8 Data Direct DMA path"
: "${HOST_RDMA_DIR:=$PWD/hostrdma}"

# Checkpoint location per node: both local copies of the identical pinned revision.
: "${MODEL_DIR_RANK0:=/models/derived/DeepSeek-V4.1-Flash-1017-KeysAblit}"
: "${MODEL_DIR_RANK1:=/models/derived/dsv41-1017-official}"
: "${MODEL_NFS_EXPORT:=}"
: "${MODEL_NFS_MOUNT:=$PWD/models}"
: "${CACHE_ROOT:=/models/gb300-pair-cache}                      # per-node compiler/JIT caches (local disk)"

# Parallelism: one GB300 per node -> TP2 across the two nodes (Shape A; stock).
: "${TP_SIZE:=2}"
: "${EP_SIZE:=2}"

# Serving profile knobs.
: "${MODE:=low-latency}                            # throughput (no speculation) | low-latency (DSpark)"
: "${MEM_FRACTION_STATIC:=0.80}"
: "${CONTEXT_LENGTH:=1048576}"
: "${CHUNKED_PREFILL_SIZE:=16384}"
: "${MAX_PREFILL_TOKENS:=32768}"
: "${MAX_RUNNING_REQUESTS:=128}"
: "${CUDA_GRAPH_MAX_BS_DECODE:=64}"
: "${CUDA_GRAPH_MAX_BS_PREFILL:=}"
: "${KV_CACHE_DTYPE:=fp8}                   # empty = model default"
: "${ENGRAM_HOST_TABLE:=1}                # 1 -> Engram host table (189 GiB does not fit in HBM)"
: "${ENGRAM_LAYOUT:=private}                    # shared cannot span two hosts"
: "${ENGRAM_PIN:=1}                        # 1 -> cudaHostRegister the shard"
: "${ENGRAM_THP:=1}"    # 1 -> 2 MiB THP-backed Engram lookups
: "${SWA_BOUNDED_REPLAY:=0}"
: "${PREFILL_GRAPH_BACKEND:=}"
: "${LANGUAGE_MODEL_ONLY:=0}"
: "${DISABLE_OVERLAP:=0}"
: "${ALLREDUCE_FUSION:=off}"
# Research only - arms the torch profiler; anyone with API access can profile to disk:
# : "${EXTRA_ARGS:=--mm-encoder-tp-mode data --profiler-config.profiler=torch --profiler-config.torch_profiler_dir=/root/.cache/vllm/profile --profiler-config.torch_profiler_with_stack=true --profiler-config.torch_profiler_record_shapes=true}"
: "${EXTRA_ARGS:=--mm-encoder-tp-mode data}          # appended verbatim to the engine command line"
: "${EXTRA_ENV:=}                                 # newline-separated KEY=VALUE pairs passed as container env"

# vLLM-only knobs. Shape A = TP2 + DSpark, fully stock (VLLM_PARALLEL=tp, MODE=low-latency, no patches).
# PP2 + DSpark (the shape this repo ships): VLLM_PARALLEL=pp + VLLM_PATCH_PP2_FLAG=1.
: "${VLLM_PATCH_ONESHOT_AR:=0}"             # 1 -> one-shot 2-rank all-reduce overlay; gate: nccl-tests bracket first
: "${VLLM_PATCH_GRAPH_ATTR:=0}"              # 1 -> graph-attribution overlay (one-boot diagnostic only)
: "${VLLM_DRAFT_SAMPLE_METHOD:=probabilistic}"   # dspark drafter sampling: probabilistic | greedy
: "${VLLM_PATCH_PP2_FLAG:=1}"            # 1 -> PP2 one-liner ClassVar overlay (gates pp+DSpark launches)
: "${VLLM_PARALLEL:=pp}                           # pp (TP1 x PP2) | tp (TP2 x PP1)"
: "${VLLM_PP_LAYER_PARTITION:=}"
: "${VLLM_GPU_MEMORY_UTILIZATION:=0.9}"
: "${VLLM_LANGUAGE_MODEL_ONLY:=0}                 # 0 = vision enabled (fleet requirement); catid receipts are all text-only"
: "${VLLM_PREFIX_CACHING:=1}                                # 1 -> --enable-prefix-caching"
: "${VLLM_FLASHINFER_AUTOTUNE:=0}                 # 0 -> --no-enable-flashinfer-autotune (distributed autotune deadlocks across nodes)"
: "${VLLM_ASYNC_SCHEDULING:=1}                    # 0 -> --no-async-scheduling"
: "${VLLM_KV_CACHE_DTYPE:=fp8}"
VLLM_ATTENTION_CONFIG='{"backend": "FLASHINFER_MLA_SPARSE_DSV41", "indexer_kv_dtype": "mxfp4", "indexer_sparse_logits": true}'
: "${VLLM_ATTENTION_CONFIG:=}"
: "${VLLM_COMPILATION_CONFIG:=}"
: "${VLLM_DSPEC_TOKENS:=5}"
: "${VLLM_ADAPTIVE_VERIFICATION:=0}"  # 1 -> adaptive verification (off: full-5 drafting)
: "${VLLM_ENFORCE_EAGER:=0}"
: "${VLLM_OVERRIDE_GENERATION_CONFIG:=}"
VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"preserve_thinking": true}'
: "${VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS:=}"
: "${VLLM_RUST_FRONTEND:=0}"
: "${VLLM_MASTER_PORT:=29501}"
: "${VLLM_DEEP_GEMM_WARMUP:=relax}                # skip | relax | full"
: "${VLLM_PATCH_PP:=0}                                # 1 -> bind-mount patches/dsv41_pp2 (required for PP2 in the 0909 build)"
: "${VLLM_PATCH_PP_DSPARK:=0}                    # 1 -> also bind-mount the 5-file PP2+DSpark overlay (patches/dsv41_pp2_dspark)"

if [[ "$SWAP_RANKS" == 1 && "${SWAP_APPLIED:-0}" != 1 ]]; then
  _t="$RANK0_IP"; RANK0_IP="$RANK1_IP"; RANK1_IP="$_t"
  _t="$MODEL_DIR_RANK0"; MODEL_DIR_RANK0="$MODEL_DIR_RANK1"; MODEL_DIR_RANK1="$_t"
  API_HOST=0.0.0.0
  SWAP_APPLIED=1
fi
if [[ "$SWAP_RANKS" == 1 ]]; then API_URL="http://$RANK0_IP:$API_PORT"; else API_URL="http://$API_HOST:$API_PORT"; fi
